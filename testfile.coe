; INSTRUCTIONS
;  0) CLR A                  ; A changes, C=0
;  1) LOAD 19, A             ; A=0x13
;  2) 0x13
;  3) BCD0 A
;  4) OUT A
;  5) LOAD 20, B             ; B=0x14
;  6) 0x14
;  7) BCD0 B
;  8) OUT B
;  9) ADD A                  ; A changes, C=0
; 10) BCD0 A
; 11) OUT A
; 12) CLR A                  ; A changes, C=0
; 13) CLR A
; 14) BCD0 A
; 15) OUT A
; 16) DEB 0,A                ; sample debounced P0 to A
; 17) BCD0 A
; 18) CLR A                  ; prep for carry test section
; 19) 0x07
; 20) 0x03
; 21) COM A                  ; A changes, C=1
; 22) BCD0 A
; 23) OUT A
; 24) BCS 31                 ; verify COM set carry
; 25) 0x1F
; 26) CLR A                  ; fail path if BCS not taken
; 27) BCD0 A
; 28) OUT A
; 29) BCC 0                  ; fail loop
; 30) 0x00
; 31) CLR A                  ; A changes, C=0
; 32) BCD0 A
; 33) OUT A
; 34) BCC 40                 ; verify CLR cleared carry
; 35) 0x28
; 36) COM A                  ; fail path if BCC not taken
; 37) BCD0 A
; 38) OUT A
; 39) BCC 0                  ; not taken when C=1
; 40) LOAD 62, A             ; A=0xFF
; 41) 0x3E
; 42) BCD0 A
; 43) OUT A
; 44) LOAD 63, B             ; B=0x01
; 45) 0x3F
; 46) BCD0 B
; 47) OUT B
; 48) ADD A                  ; A changes, C=1
; 49) BCD0 A
; 50) OUT A
; 51) BCS 56                 ; verify ADD carry set
; 52) 0x38
; 53) CLR A                  ; fail path
; 54) BCD0 A
; 55) OUT A
; 56) CLR A                  ; A changes, C=0 before loop
; 57) BCD0 A
; 58) OUT A
; 59) BCC 0                  ; loop to beginning forever
; 60) 0x00
; 61) filler
; 62) 0xFF
; 63) 0x01
